*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
google-services.json
GoogleService-Info.plist

# Metro bundler
.metro-health-check*

# Environment variables (keep .env.example as the template)
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Claude Code personal settings (shared settings.json is kept)
.claude/settings.local.json

# OS / editor junk
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/
